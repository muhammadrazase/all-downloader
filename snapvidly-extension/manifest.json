{
  "manifest_version": 3,
  "name": "SnapVidly — Video Downloader",
  "version": "1.0.0",
  "description": "One click: opens SnapVidly with the current video link ready to download. TikTok, YouTube, Instagram, X, Reddit, Pinterest, Vimeo, Twitch and more.",
  "homepage_url": "https://snapvidly.com/browser-extension",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Download this page with SnapVidly",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.pinterest.com/*",
        "*://*.vimeo.com/*",
        "*://*.twitch.tv/*",
        "*://*.tumblr.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "snapvidly@snapvidly.com", "strict_min_version": "109.0" }
  }
}
