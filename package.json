{
  "name": "super-social-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Super Social Downloader (SSD) — fast, SEO-first social media video downloader, blog and community.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pwa": "node scripts/build-pwa.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "indexnow": "node scripts/indexnow.mjs",
    "postinstall": "node scripts/copy-ffmpeg.mjs && node scripts/copy-pdf-assets.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset": "node scripts/create-admin.mjs",
    "build:geo": "node scripts/build-geo-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:tools": "playwright test e2e/allTools.spec.ts",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@sfpy/node-sdk": "^3.0.2",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "better-sqlite3": "^12.11.1",
    "fflate": "^0.8.3",
    "gray-matter": "4.0.3",
    "heic-to": "^1.5.2",
    "jsqr": "^1.4.0",
    "next": "15.5.26",
    "next-mdx-remote-client": "^2.1.12",
    "nodemailer": "^10.0.11",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "syllable": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "3.24.1"
  },
  "overrides": {
    "@sfpy/node-sdk": {
      "axios": "^1.20.0"
    },
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  }
}
