# ── Site URL ────────────────────────────────────────────────────────
# Your live domain. Drives canonical tags, sitemap, manifest and the QR code.
# up.sh sets this automatically from DOMAIN; set it here for local/manual runs.
NEXT_PUBLIC_SITE_URL=https://snapvidly.com

# ── Extraction engine ───────────────────────────────────────────────
# If set, /api/extract forwards to this engine service (production).
# If unset, it falls back to a local yt-dlp binary (self-host / dev).
ENGINE_URL=
ENGINE_KEY=

# Absolute paths to the binaries (up.sh sets these automatically on the VPS).
# Needed so the Next.js server always finds them.
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg

# Engine hardening (local yt-dlp mode):
# Cookies file — needed for many Instagram/Facebook videos and for YouTube when
# it shows "sign in to confirm you're not a bot" on datacenter/VPS IPs.
YTDLP_COOKIES=
# Proxy URL (http://user:pass@host:port) — helps when a platform blocks your VPS IP.
YTDLP_PROXY=
# Max simultaneous downloads (protects small VPS CPU) and max file size (MB).
MAX_CONCURRENT_DOWNLOADS=3
MAX_DOWNLOAD_MB=1500

# ── Rate limiting ───────────────────────────────────────────────────
# Optional: with Upstash it's distributed; WITHOUT it, a built-in in-memory
# limiter still protects a single server. Tune the in-memory cap here.
RATE_LIMIT_PER_MIN=20
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Community ───────────────────────────────────────────────────────
# Discord + Telegram invite links (empty = the cards/links stay hidden).
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Chrome extension — the Chrome Web Store URL (empty = page shows "coming soon").
# e.g. https://chromewebstore.google.com/detail/snapvidly/<extension-id>
NEXT_PUBLIC_CHROME_EXTENSION_URL=
# Giscus (GitHub Discussions) board
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ── Contact form email (SMTP) ───────────────────────────────────────
# When set, /api/contact sends messages by email. If blank, the form falls
# back to opening the visitor's mail app (mailto). Use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                 # e.g. "SnapVidly <you@yourdomain.com>" (defaults to SMTP_USER)
CONTACT_TO=                # where messages are delivered (defaults to site email)

# ── SEO: Search Console verification (paste the token only) ─────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Analytics (set one; both are cookieless-friendly) ───────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# ── Consent (GDPR/CCPA) ─────────────────────────────────────────────
# "true" = show a cookie banner and load ads/analytics ONLY after Accept.
# Leave blank/false to load them immediately (simpler; typical for utility sites).
NEXT_PUBLIC_CONSENT_REQUIRED=

# ── Ad networks (all optional) ──────────────────────────────────────
# Fill in only the ones you use, then rebuild. Blank = that network is fully off.
# Display banners use this priority: Ezoic → Media.net → Adsterra.

# Ezoic (set to "true" once your site is active in Ezoic; create placeholder
# ids 101 & 102 in the Ezoic dashboard to match the in-content slots).
NEXT_PUBLIC_EZOIC_ENABLED=

# Media.net (contextual display)
NEXT_PUBLIC_MEDIANET_CID=
NEXT_PUBLIC_MEDIANET_SLOT_LEADERBOARD=
NEXT_PUBLIC_MEDIANET_SLOT_RECTANGLE=

# Adsterra — global formats (paste the exact script src) + banner keys
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY_LEADERBOARD=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY_RECTANGLE=

# Monetag (paste the tag script src; add zone if your snippet uses data-zone)
NEXT_PUBLIC_MONETAG_SRC=
NEXT_PUBLIC_MONETAG_ZONE=

# PropellerAds (paste the tag script src; add zone if needed)
NEXT_PUBLIC_PROPELLERADS_SRC=
NEXT_PUBLIC_PROPELLERADS_ZONE=

# HilltopAds — popunder script src
NEXT_PUBLIC_HILLTOPADS_POPUNDER_SRC=

# Galaksion — script src
NEXT_PUBLIC_GALAKSION_SRC=

# ── Fast indexing (Bing/Yandex via IndexNow) ────────────────────────
# Optional. `npm run indexnow` auto-generates a key if this is blank.
INDEXNOW_KEY=
